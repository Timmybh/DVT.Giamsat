<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS làm reverse proxy tới app Node (start.bat, cổng 8374). Cần cài URL Rewrite + Application Request Routing (ARR) và bật proxy ARR. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="DVT Giam sat -> Node" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:8374/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Không để IIS chặn / nén lại response của Node -->
    <httpErrors existingResponse="PassThrough" />
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
  </system.webServer>
</configuration>
